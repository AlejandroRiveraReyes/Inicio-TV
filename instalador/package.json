{
  "name": "instalador-inicio-tv",
  "version": "1.0.0",
  "description": "Instala el launcher Inicio TV en una Android TV desde el ordenador",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --mac --win",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.launchertv.installer",
    "productName": "Instalador Inicio TV",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/inicio-tv.apk",
        "to": "inicio-tv.apk"
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "identity": null,
      "icon": "resources/icon.png",
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "Instalador-Inicio-TV-${version}-Mac-${arch}.${ext}"
    },
    "win": {
      "icon": "resources/icon.png",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Instalador-Inicio-TV-${version}-Windows.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  }
}
